{
  "name": "react-use-cache-monorepo",
  "version": "0.4.0",
  "author": "Jerome Kenway",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "lint": "oxlint packages examples",
    "format": "oxfmt \"packages/**/*.ts\" \"packages/**/*.tsx\" \"examples/**/*.ts\" \"examples/**/*.tsx\"",
    "format:check": "oxfmt --check \"packages/**/*.ts\" \"packages/**/*.tsx\" \"examples/**/*.ts\" \"examples/**/*.tsx\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0"
  }
}